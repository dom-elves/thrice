includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
    ignoreErrors:
        - '#Static method Redis::pipeline\(\) invoked with 1 parameter, 0 required#'
        
    level: 7
